      {
        "if": { "current_dimension": "default" },
        "then": {
          "if": {
            "not": { "math": [ "u_has_proficiency('astral_prof_striking_1')" ] }
          },
          "then": {
            "math": [ "u_proficiency('astral_prof_striking_1', 'format': 'time_spent') += time('10 m')" ]
          },
          "else": {
            "if": {
              "not": { "math": [ "u_has_proficiency('astral_prof_striking_2')" ] }
            },
